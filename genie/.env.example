# Copy to .env and fill in.  (Existing shell env vars override these.)

# Workspace URL. Azure looks like https://adb-<id>.<n>.azuredatabricks.net
DATABRICKS_HOST=

# The Genie space (a.k.a. Genie room) you are wrapping.
GENIE_SPACE_ID=

# --- Auth: the SP's identity (same in both modes below) ----------------------
CLIENT_ID=          # the SP's Application (client) ID
CLIENT_SECRET=      # the SP secret (see the two modes below)

# --- Mode A: NATIVE Entra SP (recommended for an Entra-native shop) -----------
# Set TENANT_ID and the script authenticates the SP through Entra (its native
# issuer): Entra secret -> login.microsoftonline.com -> AAD token, which Azure
# Databricks accepts first-party. Here CLIENT_SECRET is the ENTRA app secret.
# The SP must be assigned to the workspace.
TENANT_ID=          # Entra (Azure AD) tenant/directory ID  (leave blank for Mode B)

# Optional: override the question step 4 asks.
# GENIE_QUESTION=What data is available in this space?
