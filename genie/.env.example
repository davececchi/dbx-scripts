# Copy to .env and fill in.  (Existing shell env vars override these.)

# Workspace URL. Azure looks like https://adb-<id>.<n>.azuredatabricks.net
DATABRICKS_HOST=

# The Genie space (a.k.a. Genie room) you are wrapping.
GENIE_SPACE_ID=

# --- Auth option 1: OAuth M2M as a service principal (recommended) ----------
# On Azure Databricks, /oidc/v1/token is Entra-backed (first-party service):
#   CLIENT_ID     = the SP's Entra Application (client) ID
#   CLIENT_SECRET = a Databricks-managed OAuth secret on that SP
#                   (Settings > Identity and access > Service principals >
#                    <sp> > Secrets > Generate secret)
CLIENT_ID=
CLIENT_SECRET=

# --- Auth option 2: bring your own bearer token -----------------------------
# If set, steps skip OAuth and test everything with this token instead.
# Use to test a raw Entra AAD token (az account get-access-token \
#   --resource 2ff814a6-3304-4ab8-85cb-cd0e6f879c1d) or a PAT.
# DATABRICKS_TOKEN=

# Optional: override the question step 4 asks.
# GENIE_QUESTION=What data is available in this space?
